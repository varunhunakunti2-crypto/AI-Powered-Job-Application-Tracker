---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sign In — AI Job Tracker">
  <div class="min-h-screen flex flex-col justify-center py-12 sm:px-6 lg:px-8 bg-canvas-soft relative overflow-hidden">
    
    <!-- Floating Top-Right Theme Toggle -->
    <div class="absolute top-4 right-4 z-20">
      <button
        id="theme-toggle-btn"
        class="h-8 w-8 flex items-center justify-center border border-hairline rounded-sm text-xs font-medium hover:bg-canvas-soft-2 transition-all cursor-pointer text-ink bg-canvas"
        aria-label="Toggle Theme"
      >
        <svg class="h-4 w-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <svg class="h-4 w-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
        </svg>
      </button>
    </div>

    <!-- Stark Mesh Gradient Background Blur (Vercel Style) -->
    <div class="absolute top-[-20%] left-[50%] -translate-x-[50%] w-[600px] h-[300px] bg-gradient-to-r from-success-soft via-warning-soft to-error-soft rounded-full blur-[120px] opacity-40 pointer-events-none"></div>

    <div class="sm:mx-auto sm:w-full sm:max-w-md z-10">
      <h2 class="text-center text-3xl font-semibold tracking-tight text-ink font-geist">
        Welcome back.
      </h2>
      <p class="mt-2 text-center text-sm text-body-text">
        Log in to manage your AI job applications tracker.
      </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md z-10 px-4 sm:px-0">
      <div class="bg-canvas border border-hairline py-8 px-6 shadow-sm rounded-lg sm:px-10">
        
        <!-- Success Alert (Redirected from Registration) -->
        <div id="success-alert" class="hidden mb-6 p-4 rounded-md bg-success-soft border border-link/20 text-sm text-success-deep font-medium">
          Registration successful! Please sign in using your credentials.
        </div>

        <!-- Error Alert -->
        <div id="error-alert" class="hidden mb-6 p-4 rounded-md bg-error-soft border border-error-deep/10 text-sm text-error-deep font-medium">
          <span id="error-message"></span>
        </div>

        <form class="space-y-6" id="login-form" novalidate>
          <div>
            <label for="email" class="block text-sm font-medium text-body-text">
              Email address
            </label>
            <div class="mt-1">
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="block w-full h-10 px-3 bg-canvas border border-hairline rounded-sm text-sm placeholder-mute-text focus:outline-none focus:border-hairline-strong focus:ring-1 focus:ring-hairline-strong transition-all"
                placeholder="you@example.com"
              />
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between">
              <label for="password" class="block text-sm font-medium text-body-text">
                Password
              </label>
            </div>
            <div class="mt-1">
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                class="block w-full h-10 px-3 bg-canvas border border-hairline rounded-sm text-sm placeholder-mute-text focus:outline-none focus:border-hairline-strong focus:ring-1 focus:ring-hairline-strong transition-all"
                placeholder="••••••••"
              />
            </div>
          </div>

          <div>
            <button
              type="submit"
              id="submit-btn"
              class="w-full flex justify-center items-center h-10 px-4 border border-transparent rounded-full shadow-sm text-sm font-medium text-on-primary bg-primary hover:bg-primary/95 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer transition-all"
            >
              <svg
                id="submit-spinner"
                class="hidden animate-spin -ml-1 mr-2 h-4 w-4 text-on-primary"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id="submit-text">Sign In</span>
            </button>
          </div>
        </form>

        <div class="mt-6">
          <div class="relative flex justify-center text-xs">
            <span class="bg-canvas px-2 text-mute-text">
              Don't have an account? 
              <a href="/signup" class="font-medium text-link hover:text-link-deep transition-all">Sign up</a>
            </span>
          </div>
        </div>

      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  // DOM Elements
  const form = document.querySelector('#login-form') as HTMLFormElement;
  const emailInput = document.querySelector('#email') as HTMLInputElement;
  const passwordInput = document.querySelector('#password') as HTMLInputElement;
  const submitButton = document.querySelector('#submit-btn') as HTMLButtonElement;
  const spinner = document.querySelector('#submit-spinner') as HTMLElement;
  const btnText = document.querySelector('#submit-text') as HTMLElement;
  const errorAlert = document.querySelector('#error-alert') as HTMLElement;
  const errorMessage = document.querySelector('#error-message') as HTMLElement;
  const successAlert = document.querySelector('#success-alert') as HTMLElement;

  // Initialize
  const init = async () => {
    // Corner Theme Toggler Link setup
    document.querySelector('#theme-toggle-btn')?.addEventListener('click', () => {
      (window as any).toggleTheme();
    });

    // Check for "registered=true" in the URL to show success banner
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('registered') === 'true') {
      successAlert?.classList.remove('hidden');
    }

    // Auto-redirect if session is active
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session) {
        window.location.href = '/dashboard';
      }
    } catch (err) {
      console.error('Error fetching session:', err);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Inline Validation Helpers
  function setValidationError(inputEl: HTMLInputElement, message: string) {
    clearValidationError(inputEl);
    inputEl.classList.add('border-error-deep', 'focus:border-error-deep', 'focus:ring-error-deep');
    const errEl = document.createElement('p');
    errEl.className = 'mt-1.5 text-xs text-error-deep font-medium inline-validation-error';
    errEl.textContent = message;
    inputEl.parentElement?.appendChild(errEl);
  }

  function clearValidationError(inputEl: HTMLInputElement) {
    inputEl.classList.remove('border-error-deep', 'focus:border-error-deep', 'focus:ring-error-deep');
    const parent = inputEl.parentElement;
    if (parent) {
      const existing = parent.querySelector('.inline-validation-error');
      if (existing) existing.remove();
    }
  }

  // Live clear on input change
  emailInput?.addEventListener('input', () => clearValidationError(emailInput));
  passwordInput?.addEventListener('input', () => clearValidationError(passwordInput));

  // Handle Form Submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Reset alert statuses
    errorAlert?.classList.add('hidden');
    successAlert?.classList.add('hidden');
    if (errorMessage) errorMessage.textContent = '';

    const email = emailInput?.value.trim() || '';
    const password = passwordInput?.value || '';

    // Validate inputs
    let hasError = false;
    clearValidationError(emailInput);
    clearValidationError(passwordInput);

    if (!email) {
      setValidationError(emailInput, 'Email is required.');
      hasError = true;
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setValidationError(emailInput, 'Please enter a valid email address.');
      hasError = true;
    }

    if (!password) {
      setValidationError(passwordInput, 'Password is required.');
      hasError = true;
    } else if (password.length < 6) {
      setValidationError(passwordInput, 'Password must be at least 6 characters.');
      hasError = true;
    }

    if (hasError) return;

    // Show Loading state
    if (submitButton) submitButton.disabled = true;
    spinner?.classList.remove('hidden');
    if (btnText) btnText.textContent = 'Signing in...';

    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) {
        if (errorMessage) errorMessage.textContent = error.message;
        errorAlert?.classList.remove('hidden');
        if ((window as any).showToast) (window as any).showToast(error.message, 'error');
        
        if (submitButton) submitButton.disabled = false;
        spinner?.classList.add('hidden');
        if (btnText) btnText.textContent = 'Sign In';
      } else {
        // Successful sign in
        if ((window as any).showToast) (window as any).showToast('Logged in successfully.', 'success');
        window.location.href = '/dashboard';
      }
    } catch (err: any) {
      const errMsg = err.message || 'An unexpected error occurred.';
      if (errorMessage) errorMessage.textContent = errMsg;
      errorAlert?.classList.remove('hidden');
      if ((window as any).showToast) (window as any).showToast(errMsg, 'error');
      
      if (submitButton) submitButton.disabled = false;
      spinner?.classList.add('hidden');
      if (btnText) btnText.textContent = 'Sign In';
    }
  });
</script>
