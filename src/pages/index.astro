---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI Job Tracker — Land Your Target Role with AI">
  <div class="min-h-screen flex flex-col bg-canvas-soft relative overflow-hidden selection:bg-primary selection:text-on-primary">
    
    <!-- Top Sticky Header -->
    <nav class="sticky top-0 z-50 bg-canvas/80 backdrop-blur-md border-b border-hairline">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-lg font-bold tracking-tight text-ink flex items-center gap-2">
            <span class="text-on-primary bg-primary px-1.5 py-0.5 rounded-xs font-mono text-xs">AI</span>
            Job Tracker
          </span>
        </div>
        <div class="hidden md:flex items-center gap-6 text-sm text-body-text">
          <a href="#features" class="hover:text-ink transition-all">Features</a>
          <a href="#ai-matching" class="hover:text-ink transition-all">AI Matching</a>
          <a href="#analytics" class="hover:text-ink transition-all">Pipeline</a>
        </div>
        <div class="flex items-center gap-3">
          <!-- Theme Toggle Button -->
          <button
            id="theme-toggle-btn"
            class="h-8 w-8 flex items-center justify-center border border-hairline rounded-sm text-xs font-medium hover:bg-canvas-soft-2 transition-all cursor-pointer text-ink"
            aria-label="Toggle Theme"
          >
            <!-- Moon Icon -->
            <svg class="h-4 w-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
            <!-- Sun Icon -->
            <svg class="h-4 w-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
            </svg>
          </button>
          <a
            href="/login"
            class="h-8 px-3 flex items-center text-xs font-medium text-ink rounded-sm hover:bg-canvas-soft-2 transition-all"
          >
            Log In
          </a>
          <a
            href="/signup"
            class="h-8 px-3 flex items-center justify-center text-xs font-semibold text-on-primary bg-primary rounded-sm hover:bg-primary/95 transition-all shadow-sm"
          >
            Sign Up
          </a>
        </div>
      </div>
    </nav>

    <!-- Stark Mesh Gradient Background Blur (Vercel Style) -->
    <div class="absolute top-[10%] left-[50%] -translate-x-[50%] w-[900px] h-[400px] bg-gradient-to-r from-success-soft via-warning-soft to-error-soft rounded-full blur-[140px] opacity-40 pointer-events-none"></div>

    <!-- Hero Section -->
    <section class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-20 text-center z-10 flex-1 flex flex-col justify-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-canvas-soft-2 border border-hairline rounded-full text-[11px] font-mono text-mute-text mb-6">
        <span class="text-on-primary bg-primary px-1.5 py-0.5 rounded-full text-[9px] font-sans font-semibold uppercase">NEW</span>
        <span>AI-powered tracking engine v1.0</span>
      </div>
      
      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-ink font-geist max-w-4xl mx-auto leading-tight sm:leading-none">
        Land your target developer role with AI.
      </h1>
      
      <p class="mt-6 text-base sm:text-lg text-body-text max-w-2xl mx-auto font-geist">
        Track job applications, extract key job info automatically, evaluate skill compatibility, and generate custom cover letters using Gemini 1.5 Flash.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/signup"
          class="w-full sm:w-auto h-12 px-8 flex items-center justify-center text-sm font-medium text-on-primary bg-primary rounded-full hover:bg-primary/95 shadow-md hover:shadow-lg hover:scale-105 active:scale-95 transition-all cursor-pointer"
        >
          Start Tracking Free
        </a>
        <a
          href="/login"
          class="w-full sm:w-auto h-12 px-8 flex items-center justify-center text-sm font-medium text-ink bg-canvas border border-hairline rounded-full hover:bg-canvas-soft-2 transition-all cursor-pointer"
        >
          Access Dashboard
        </a>
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="relative bg-canvas border-t border-hairline py-20 z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <p class="text-xs font-mono uppercase tracking-wider text-mute-text">Complete Workflow</p>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink mt-2">
            Engineered for modern builders.
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Card 1 -->
          <div class="bg-canvas border border-hairline p-6 rounded-md shadow-sm space-y-3">
            <div class="h-8 w-8 rounded-sm bg-canvas-soft-2 border border-hairline flex items-center justify-center text-ink font-mono text-xs font-bold">1</div>
            <h3 class="text-sm font-semibold text-ink">Smart Kanban Pipeline</h3>
            <p class="text-xs text-body-text leading-relaxed">
              Organize your job search columns visually (Saved, Applied, Interview, Offer, Rejected) using intuitive drag and drop features.
            </p>
          </div>
          <!-- Card 2 -->
          <div class="bg-canvas border border-hairline p-6 rounded-md shadow-sm space-y-3">
            <div class="h-8 w-8 rounded-sm bg-canvas-soft-2 border border-hairline flex items-center justify-center text-ink font-mono text-xs font-bold">2</div>
            <h3 class="text-sm font-semibold text-ink">Gemini AI Skill Matching</h3>
            <p class="text-xs text-body-text leading-relaxed">
              Paste job descriptions to evaluate compatibility, calculate match scores, and pinpoint missing skills compared to your profile.
            </p>
          </div>
          <!-- Card 3 -->
          <div class="bg-canvas border border-hairline p-6 rounded-md shadow-sm space-y-3">
            <div class="h-8 w-8 rounded-sm bg-canvas-soft-2 border border-hairline flex items-center justify-center text-ink font-mono text-xs font-bold">3</div>
            <h3 class="text-sm font-semibold text-ink">Tailored Cover Letters & Prep</h3>
            <p class="text-xs text-body-text leading-relaxed">
              Generate custom cover letters aligned to job roles and prepare for interview questions using integrated Gemini AI models.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-canvas-soft border-t border-hairline py-12 z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-xs text-mute-text">
          &copy; 2026 AI Job Tracker. Inspired by Vercel's clean developer aesthetics.
        </p>
        <div class="flex items-center gap-6 text-xs text-mute-text">
          <a href="#" class="hover:text-ink transition-all">Privacy</a>
          <a href="#" class="hover:text-ink transition-all">Terms</a>
          <a href="https://github.com" target="_blank" class="hover:text-ink transition-all">GitHub</a>
        </div>
      </div>
    </footer>

  </div>
</Layout>

<script>
  document.querySelector('#theme-toggle-btn')?.addEventListener('click', () => {
    (window as any).toggleTheme();
  });
</script>
