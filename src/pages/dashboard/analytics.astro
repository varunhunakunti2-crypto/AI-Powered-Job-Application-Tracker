---
import Layout from '../../layouts/Layout.astro';
import AnalyticsDashboard from '../../components/AnalyticsDashboard';
---

<Layout title="Analytics — AI Job Tracker">
  <div class="min-h-screen bg-canvas-soft text-ink font-geist flex flex-col">
    <!-- Navbar -->
    <header class="sticky top-0 z-40 bg-canvas border-b border-hairline backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <a href="/dashboard" class="text-xl font-bold tracking-tight text-ink flex items-center gap-2">
            <span class="text-on-primary bg-primary px-2 py-0.5 rounded-sm font-mono text-sm">AI</span>
            Job Tracker
          </a>
          <nav class="flex items-center gap-4">
            <a href="/dashboard" class="text-xs font-medium text-body-text hover:text-ink transition-all">Pipeline</a>
            <a href="/dashboard/analytics" class="text-xs font-semibold text-ink border-b-2 border-primary py-5 -mb-5 transition-all">Analytics</a>
            <a href="/dashboard/profile" class="text-xs font-medium text-body-text hover:text-ink transition-all">Profile</a>
          </nav>
        </div>
        <div class="flex items-center gap-4">
          <!-- Theme Toggle Button -->
          <button
            id="theme-toggle-btn"
            class="h-8 w-8 flex items-center justify-center border border-hairline rounded-sm text-xs font-medium hover:bg-canvas-soft-2 transition-all cursor-pointer text-ink"
            aria-label="Toggle Theme"
          >
            <svg class="h-4 w-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
            <svg class="h-4 w-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
            </svg>
          </button>
          <div class="text-right hidden sm:block">
            <p class="text-xs font-semibold text-ink" id="profile-name">Loading Profile...</p>
            <p class="text-[10px] text-mute-text" id="profile-email">loading@user.com</p>
          </div>
          <button
            id="signout-btn"
            class="h-8 px-3 border border-hairline rounded-sm text-xs font-medium hover:bg-canvas-soft-2 transition-all cursor-pointer"
          >
            Sign Out
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Grid -->
    <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8">
      <AnalyticsDashboard client:only="react" />
    </main>
  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  // State
  let currentUser: any = null;
  let userProfile: any = null;

  // DOM Elements
  const profileName = document.querySelector('#profile-name') as HTMLElement;
  const profileEmail = document.querySelector('#profile-email') as HTMLElement;
  const signoutBtn = document.querySelector('#signout-btn') as HTMLButtonElement;

  // Initialize page
  document.addEventListener('DOMContentLoaded', async () => {
    // Corner Theme Toggler Link setup
    document.querySelector('#theme-toggle-btn')?.addEventListener('click', () => {
      (window as any).toggleTheme();
    });

    // 1. Authenticate user
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = '/login';
      return;
    }
    currentUser = session.user;
    
    // 2. Load User Profile
    await loadUserProfile();

    // 3. Set up event listeners
    setupEvents();
  });

  // Load Profile from DB
  async function loadUserProfile() {
    try {
      const { data, error } = await supabase
          .from('profiles')
          .select('*')
          .eq('id', currentUser.id)
          .single();

      if (error && error.code !== 'PGRST116') throw error;

      if (data) {
        userProfile = data;
      } else {
        // Fallback: create empty profile if missing
        const { data: insertedData, error: insertError } = await supabase
          .from('profiles')
          .insert({
            id: currentUser.id,
            email: currentUser.email,
            full_name: currentUser.user_metadata?.full_name || 'Guest User'
          })
          .select()
          .single();
        if (insertError) throw insertError;
        userProfile = insertedData;
      }

      // Display Metadata
      if (profileName) profileName.textContent = userProfile.full_name || 'Guest User';
      if (profileEmail) profileEmail.textContent = userProfile.email || currentUser.email;

    } catch (err: any) {
      console.error('Error loading user profile:', err);
      if ((window as any).showToast) (window as any).showToast(err.message || 'Error loading profile.', 'error');
    }
  }

  function setupEvents() {
    // Sign out btn
    signoutBtn?.addEventListener('click', async () => {
      const { error } = await supabase.auth.signOut();
      if (!error) {
        window.location.href = '/login';
      }
    });
  }
</script>
